menu "RT-Smart 3rd-party Configuration"

    config RTSMART_3RD_PARTY_ENABLE_FREETYPE
        bool "Enable Build FreeType"
        default y

    menuconfig RTSMART_3RD_PARTY_ENABLE_LVGL
        bool "Enable Build LVGL"
        default n

        if RTSMART_3RD_PARTY_ENABLE_LVGL
            config RTSMART_3RD_PARTY_ENABLE_LVGL_EXAMPLES
                bool "Enable LVGL Examples"
                default n
        endif

    config RTSMART_3RD_PARTY_ENABLE_MBEDTLS
        bool "Enable Build MbedTLS"
        default y

    menuconfig RTSMART_3RD_PARTY_ENABLE_MQTTCLIENT
        bool "Enable Build MQTTClient"
        default y

        if RTSMART_3RD_PARTY_ENABLE_MQTTCLIENT
            source "$(SDK_RTSMART_SRC_DIR)/libs/3rd-party/mqttclient/Kconfig"
        endif

    menuconfig RTSMART_3RD_PARTY_ENABLE_MINIHTTP
        bool "Enable Build miniHTTP"
        default n

        if RTSMART_3RD_PARTY_ENABLE_MINIHTTP
            config MINIHTTP_USE_MBEDTLS
                bool "Enable miniHTTP MbedTLS Support"
                default y if RTSMART_3RD_PARTY_ENABLE_MBEDTLS
        endif

    menuconfig RTSMART_3RD_PARTY_ENABLE_TUYALINKSDK
        bool "Enable Build Tuya IoT Core SDK"
        default n
        select RTSMART_3RD_PARTY_ENABLE_MBEDTLS

        if RTSMART_3RD_PARTY_ENABLE_TUYALINKSDK
            
        endif
endmenu
