From 6ac75e4e67ef70f54f625fa7752310ca240e36d1 Mon Sep 17 00:00:00 2001
From: RT-Smart Port <port@libwebsockets.invalid>
Date: Fri, 17 Jul 2026 15:20:00 +0800
Subject: [PATCH] core: handle fd zero during event-pipe teardown

Descriptor zero is valid, so test event-pipe endpoints against the invalid
socket sentinel instead of using their truth values.

---
 lib/core/context.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/lib/core/context.c b/lib/core/context.c
--- a/lib/core/context.c
+++ b/lib/core/context.c
@@ -2008,5 +2008,6 @@ lws_pt_destroy(struct lws_context_per_thread *pt)
-	if ((pt->dummy_pipe_fds[0] || pt->dummy_pipe_fds[1])
 #if !defined(WIN32)
-	    && ((int)pt->dummy_pipe_fds[0] != -1 || (int)pt->dummy_pipe_fds[1] != -1)
+	if ((int)pt->dummy_pipe_fds[0] != LWS_SOCK_INVALID ||
+	    (int)pt->dummy_pipe_fds[1] != LWS_SOCK_INVALID) {
+#else
+	if (pt->dummy_pipe_fds[0] || pt->dummy_pipe_fds[1]) {
 #endif
-	) {
