From 1f2f8f6f7f5e0e7f0f4b3c08e6eaa5e62c0d1a12 Mon Sep 17 00:00:00 2001
From: RT-Smart Port <port@libwebsockets.invalid>
Date: Fri, 17 Jul 2026 15:00:00 +0800
Subject: [PATCH] mbedtls: keep client ALPN storage alive

Keep the temporary ALPN buffer in function scope so its contents remain
valid for the complete TLS setup operation.

---
 lib/tls/mbedtls/mbedtls-client.c | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/lib/tls/mbedtls/mbedtls-client.c b/lib/tls/mbedtls/mbedtls-client.c
index e0c482cfb..31fcff495 100644
--- a/lib/tls/mbedtls/mbedtls-client.c
+++ b/lib/tls/mbedtls/mbedtls-client.c
@@ -97,11 +97,12 @@ lws_ssl_client_bio_create(struct lws *wsi)
 	if (wsi->a.vhost->tls.alpn)
 		alpn_comma = wsi->a.vhost->tls.alpn;
 
+	char temp_alpn[128];
+
 	if (wsi->stash) {
 		if (wsi->stash->cis[CIS_ALPN])
 			alpn_comma = wsi->stash->cis[CIS_ALPN];
 	} else {
-		char temp_alpn[128];
 		if (lws_hdr_copy(wsi, temp_alpn, sizeof(temp_alpn),
 				_WSI_TOKEN_CLIENT_ALPN) > 0)
 			alpn_comma = temp_alpn;
